# Mot de passe unique (16 caractères minimum), réservé au salon.
ADMIN_UPLOAD_PASSWORD=

# Secret aléatoire distinct (32 caractères minimum). Rotation = révocation globale.
ADMIN_SESSION_SECRET=

# Jeton d'un NOUVEAU stockage Blob PRIVÉ. Ne pas utiliser le stockage public historique.
BLOB_READ_WRITE_TOKEN=

# Base Redis dédiée à cet environnement : sessions, index de galerie et limites.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Domaine HTTPS public utilisé dans robots.txt et sitemap.xml.
PUBLIC_SITE_URL=https://www.votre-domaine.fr

# Informations réelles du médiateur conventionné (requises pour construire la production).
MEDIATOR_NAME=
MEDIATOR_ADDRESS=
MEDIATOR_URL=

# Réservé aux opérations locales, ne pas injecter dans le site ou les sauvegardes.
# 32 octets aléatoires, encodés en 64 caractères hexadécimaux.
BACKUP_ENCRYPTION_KEY=
# Ancien jeton public, uniquement pour la migration puis le nettoyage.
LEGACY_PUBLIC_BLOB_TOKEN=
