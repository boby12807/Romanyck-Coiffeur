# Mot de passe privé de la page /admin.html.
ADMIN_UPLOAD_PASSWORD=

# Long secret aléatoire utilisé pour signer les sessions administrateur.
ADMIN_SESSION_SECRET=

# Créé automatiquement lorsque le stockage Blob est connecté au projet Vercel.
BLOB_READ_WRITE_TOKEN=

# Compteurs partagés pour protéger la connexion et les actions d’administration.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Domaine HTTPS public utilisé dans robots.txt et sitemap.xml.
PUBLIC_SITE_URL=https://www.votre-domaine.fr
